---
import SectionHead from "./SectionHead.astro";
import { site, socials } from "../data/site";
---

<section class="section">
  <div class="wrap">
    <SectionHead title="Contact" aside="Open to projects of all kinds" />
    <a class="mail display reveal" href={`mailto:${site.email}`}>{site.email}</a>
    <div class="row">
      <button class="copy mono" type="button" data-copy={site.email}>Copy address</button>
      <nav class="mono" aria-label="Links">
        {
          socials.map((social) => (
            <a class="arrow" href={social.href} target="_blank" rel="me noopener">
              {social.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</section>

<script>
  import "../scripts/copy";
</script>

<style>
  .mail {
    display: block;
    width: fit-content;
    margin-top: clamp(28px, 4vw, 48px);
    font-size: clamp(18px, 7.1cqw, 112px);
    white-space: nowrap;
    transition: color 0.25s;
  }

  .mail:hover {
    color: var(--accent);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px 28px;
    margin-top: clamp(24px, 3vw, 40px);
  }

  .copy {
    appearance: none;
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 9px 16px;
    color: var(--ink);
    cursor: pointer;
    transition:
      border-color 0.2s,
      color 0.2s;
  }

  .copy:hover {
    border-color: var(--accent);
  }

  .copy.done {
    color: var(--accent);
    border-color: var(--accent);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
  }

  nav a {
    color: var(--ink);
  }
</style>
