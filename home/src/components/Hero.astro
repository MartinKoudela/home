---
import { facts, site } from "../data/site";

const lines = site.name.split(" ");
---

<header class="hero">
  <div class="wrap">
    <h1 class="display" aria-label={site.name} data-lens>
      {
        lines.map((line) => (
          <span class="line" aria-hidden="true">
            <span class="word">{[...line].map((letter) => <i>{letter}</i>)}</span>
          </span>
        ))
      }
    </h1>
    <div class="under">
      <p class="lede">{site.lede}</p>
      <dl class="facts mono">
        {
          facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
        <div data-last-push={site.github} hidden>
          <dt>Last push</dt>
          <dd><a target="_blank" rel="noopener"></a> <span></span></dd>
        </div>
      </dl>
    </div>
  </div>
</header>

<script>
  import "../scripts/lens";
  import "../scripts/last-push";
</script>

<style>
  .hero {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }

  .wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  h1 {
    margin-top: auto;
    padding-top: max(48px, env(safe-area-inset-top));
    font-size: clamp(40px, 16.2cqw, 260px);
    line-height: 0.84;
    text-transform: uppercase;
    user-select: none;
    -webkit-user-select: none;
  }

  .line {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    padding-block: 0.04em 0.12em;
    margin-bottom: -0.1em;
  }

  .word {
    display: inline-block;
    animation: rise 0.9s var(--ease) both;
  }

  .line + .line .word {
    animation-delay: 0.09s;
  }

  i {
    display: inline-block;
    font-style: normal;
    font-variation-settings:
      "wght" var(--weight, 640),
      "wdth" var(--width, 125);
  }

  .under {
    display: grid;
    gap: 32px;
    padding-block: clamp(28px, 4vw, 48px) clamp(28px, 4vw, 44px);
    animation: fade 1s 0.35s both;
  }

  .lede {
    max-width: 24ch;
    font-size: clamp(22px, 2.5cqw, 36px);
    font-weight: 450;
    line-height: 1.16;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .facts {
    display: grid;
    gap: 9px;
    align-content: end;
  }

  .facts div {
    display: grid;
    grid-template-columns: 10ch 1fr;
    gap: 16px;
  }

  .facts [hidden] {
    display: none;
  }

  dt {
    color: var(--faint);
  }

  dd {
    color: var(--ink);
  }

  dd a {
    border-bottom: 1px solid var(--line);
    transition: border-color 0.2s;
  }

  dd a:hover {
    border-color: var(--accent);
  }

  @media (min-width: 760px) {
    .under {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 48px;
    }
  }
</style>
