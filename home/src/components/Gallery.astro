---
import { Image } from "astro:assets";
import type { Figure } from "../data/types";
import { isPhone, isTall, projectImage } from "../lib/images";

interface Props {
  figures: Figure[];
  start: number;
}

const { figures, start } = Astro.props;
const items = figures.map((figure) => ({ ...figure, source: projectImage(figure.image) }));
const phones = items.every((item) => isPhone(item.source));
const layout = phones ? "phones" : items.length === 1 ? (isTall(items[0].source) ? "tall" : "single") : "pairs";
const sizes = {
  phones: "(min-width: 960px) 22vw, 45vw",
  single: "(min-width: 1200px) 1100px, 92vw",
  tall: "(min-width: 520px) 440px, 92vw",
  pairs: "(min-width: 760px) 46vw, 92vw",
}[layout];
---

<div class:list={["gallery", layout]}>
  {
    items.map((item, i) => (
      <figure class="reveal">
        <Image src={item.source} alt={item.alt} widths={[480, 960, 1600, item.source.width]} sizes={sizes} />
        <figcaption class="mono">
          Fig. {start + i} · {item.caption}
        </figcaption>
      </figure>
    ))
  }
</div>

<style>
  .gallery {
    display: grid;
    gap: clamp(28px, 4cqw, 56px) clamp(16px, 3cqw, 40px);
    align-items: start;
  }

  .phones {
    grid-template-columns: repeat(2, 1fr);
  }

  .single {
    max-width: 1100px;
  }

  .tall {
    max-width: 440px;
  }

  img {
    width: 100%;
    border: 1px solid var(--line);
  }

  figcaption {
    margin-top: 12px;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  @media (min-width: 760px) {
    .pairs {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .phones {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
